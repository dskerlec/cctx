{% render 'cc-assets' %}
<div class="cc-announce">
  <div class="cc-announce__inner">
    {%- for block in section.blocks -%}
      <span {{ block.shopify_attributes }}>
        {{- block.settings.text -}}
        {%- if block.settings.link_label != blank %} <a href="{{ block.settings.url | default: '#' }}">{{ block.settings.link_label }}</a>{% endif -%} 
      </span>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "CC Announcement bar",
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Free shipping on orders $35+" },
        { "type": "text", "id": "link_label", "label": "Link text (optional)" },
        { "type": "url", "id": "url", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "CC Announcement bar",
      "blocks": [
        { "type": "message", "settings": { "text": "Free shipping on orders $35+" } },
        { "type": "message", "settings": { "text": "Weekly giveaway:", "link_label": "enter free" } },
        { "type": "message", "settings": { "text": "Ships next business day" } }
      ]
    }
  ]
}
{% endschema %}
